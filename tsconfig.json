{
    "compilerOptions": {
        "module": "nodenext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": ".",
        "sourceMap": true,
        "inlineSources": true,
        "sourceRoot": "/",
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        // Style Options
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noUnusedLocals": true,
        // Recommended Options
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    "include": ["src/**/*", "gen/**/*", "*.config.ts"],
    "exclude": ["node_modules", "dist"]
}
