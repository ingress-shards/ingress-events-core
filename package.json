{
    "name": "@ingress-shards/shards-core",
    "version": "0.0.0-semantically-released",
    "description": "Core logic for Ingress applications which interact with shards",
    "homepage": "https://github.com/ingress-shards/shards-core#readme",
    "bugs": {
        "url": "https://github.com/ingress-shards/shards-core/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ingress-shards/shards-core.git"
    },
    "license": "MIT",
    "author": "Nick Young",
    "contributors": [
        "Lewis Keen"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "directories": {
        "lib": "src",
        "test": "tests"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc --build tsconfig.json",
        "build:watch": "tsc --build tsconfig.json --watch",
        "prepare": "yarn build",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "temporal-polyfill": "^0.3.0"
    },
    "devDependencies": {
        "@semantic-release/exec": "^7.1.0",
        "@types/node": "^25.0.9",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "semantic-release": "^25.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^4.0.17"
    },
    "packageManager": "yarn@4.12.0",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}
