{
    "name": "@ingress-shards/shards-core",
    "version": "0.0.0-semantically-released",
    "description": "Core logic for Ingress applications which interact with shards",
    "homepage": "https://github.com/ingress-shards/shards-core#readme",
    "bugs": {
        "url": "https://github.com/ingress-shards/shards-core/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ingress-shards/shards-core.git"
    },
    "license": "MIT",
    "author": "Nick Young",
    "contributors": [
        "Lewis Keen"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "assets"
    ],
    "directories": {
        "lib": "src",
        "test": "tests"
    },
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsc --build tsconfig.build.json",
        "build:watch": "tsc --build tsconfig.build.json --watch",
        "prepare": "yarn build",
        "test:unit": "yarn vitest run",
        "lint": "eslint src tests",
        "validate": "yarn clean && yarn lint && yarn build && yarn test:unit"
    },
    "dependencies": {
        "temporal-polyfill": "^0.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@semantic-release/exec": "^7.1.0",
        "@types/node": "^25.0.9",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "eslint": "^9.39.2",
        "eslint-plugin-prefer-arrow-functions": "^3.9.1",
        "eslint-plugin-unicorn": "^62.0.0",
        "globals": "^17.1.0",
        "semantic-release": "^25.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "vitest": "^4.0.18"
    },
    "packageManager": "yarn@4.12.0",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}
