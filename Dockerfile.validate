FROM node:24.13.0-alpine

RUN corepack enable

WORKDIR /app

# Step 1: Install dependencies (this layer is CACHED unless package.json/yarn.lock change)
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
RUN yarn install --immutable

# Step 2: Copy the rest of the source code
COPY . .

CMD ["yarn", "validate"]
